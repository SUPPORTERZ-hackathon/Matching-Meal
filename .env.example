# ローカル開発専用。本番では使わないでください。
FRONTEND_PORT=3000
POSTGRES_USER=meal
POSTGRES_PASSWORD=meal_local_password
POSTGRES_DB=meal
# 店舗検索の実装時に設定。環境構築時は空でOK。
HOTPEPPER_API_KEY=
# Idempotency-Key付きのルーム作成・参加に使用。`openssl rand -base64 32`などで32バイト以上を生成する。
# 未設定でも既存APIは動作するが、Idempotency-Key付きリクエストは503になる。
ROOM_IDEMPOTENCY_HMAC_KEY=
# Tunnel利用時のみ、https:// を除いたホスト名を設定
DEV_ALLOWED_ORIGIN=

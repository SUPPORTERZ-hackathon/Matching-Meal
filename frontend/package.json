{
  "name": "meal-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --webpack",
    "build": "NEXT_BUILD_DIR=.next-build next build --webpack",
    "start": "NEXT_BUILD_DIR=.next-build next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:genre-vote": "node --experimental-strip-types --test src/features/genre-vote/*.test.mjs",
    "test:genre-vote-waiting": "node --experimental-strip-types --test src/features/genre-vote-waiting/*.test.mjs",
    "test:genre-result": "node --experimental-strip-types --test src/features/genre-result/*.test.mjs",
    "test:restaurant-vote": "node --experimental-strip-types --test src/features/restaurant-vote/*.test.mjs",
    "test:restaurant-result": "node --experimental-strip-types --test src/features/restaurant-result/*.test.mjs",
    "test:room": "node --experimental-strip-types --test src/features/room/*.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "qrcode.react": "4.2.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
